[zh-cn]
name = "VictoriaMetrics"
auth = "316z666"
descript = "存储时间序列，在 VMUI 查询并绘制指标。"
important = "在应用 config 目录写入非空强口令文件 http-password，用户名为 metrics。通过受信任网络访问。"
release_note = "首个 x86_64 Beta 包，基于上游 v1.156.0-rc0。"

[zh-hk]
name = "VictoriaMetrics"
auth = "316z666"
descript = "Store time series and explore metrics in VMUI."
important = "Create a strong non-empty http-password file in the app config directory. Sign in as metrics on a trusted network."
release_note = "Initial x86_64 beta based on upstream v1.156.0-rc0."

